{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-audit-kernel/receipt.schema.json",
  "title": "Agent Audit Kernel Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "tool_id",
    "exit_code",
    "stdout_hash",
    "nonce",
    "timestamp",
    "signature",
    "input_digest"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tool_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "stdout_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "pattern": "^(hmac-sha256:[0-9a-f]{64}|ed25519:[A-Za-z0-9+/]{40,}={0,2})$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stderr_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
